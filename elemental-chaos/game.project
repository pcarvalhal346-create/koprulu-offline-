[project]
title = Elemental Chaos
version = 1.0.0
developer = Elemental Chaos
write_log = 0
compress_archive = 1

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 720
height = 1280
high_dpi = 1
fullscreen = 0
dynamic_orientation = 0
update_frequency = 0
swap_interval = 1

[render]
clear_color_red = 0.082
clear_color_green = 0.133
clear_color_blue = 0.306
clear_color_alpha = 1

[script]
shared_state = 1

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
max_characters = 16384
max_draw_calls = 2048

[gui]
max_count = 8
max_animation_count = 2048
max_particle_count = 128

[sound]
gain = 1
max_sound_instances = 64
max_sound_sources = 24

[collection]
max_instances = 64

[sprite]
max_count = 16

[resource]
max_resources = 1024

[physics]
max_collision_object_count = 0
max_collisions = 0
max_contacts = 0

[particle_fx]
max_count = 8
max_emitter_count = 8
max_particle_count = 256

[label]
max_count = 8

[collection_proxy]
max_count = 0

[factory]
max_count = 0

[collection_factory]
max_count = 0

[html5]
scale_mode = stretch
cssfile = /builtins/manifests/web/dark_theme.css
show_fullscreen_button = 0
show_made_with_defold = 0
heap_size = 256

[android]
package = com.elementalchaos.game
version_code = 1
minimum_sdk_version = 21

[ios]
bundle_identifier = com.elementalchaos.game
bundle_name = ElementalChaos

[engine]
run_while_iconified = 0
